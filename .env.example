# ============================================================
# Roadie — variáveis de ambiente
# Copie para .env e preencha. O arquivo .env nunca é versionado.
# ============================================================

# dev | prod | test
APP_ENV=dev

# ---- banco de dados (PostgreSQL) ----
POSTGRES_USER=roadie
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=roadie
POSTGRES_PORT=5432
# Usado pelo backend rodando FORA do Docker. Dentro do compose o host vira "db".
DATABASE_URL=postgresql+asyncpg://roadie:troque-esta-senha@localhost:5432/roadie

# ---- segurança ----
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true em produção (cookies só por HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# ---- primeiro administrador (criado pelo comando `roadie create-admin`) ----
ADMIN_EMAIL=admin@emporiodamusica.com.br
ADMIN_PASSWORD=troque-esta-senha-tambem
ADMIN_NAME=Gerência

# ---- modelo de linguagem (OpenAI) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL_PRIMARY=gpt-6.1-terra
OPENAI_MODEL_FALLBACK=gpt-6-luna
# openai | mock  (mock = agente simulado, sem chamadas externas; usado nos testes)
LLM_MODE=openai

# ---- relógio da loja ----
# Fuso de Campo Grande/MS. O "agora" do agente é simulado por padrão para que
# os prazos das políticas (7 dias, 30 dias) façam sentido com os dados do desafio.
# Use STORE_CLOCK=real para usar o relógio do servidor.
STORE_TIMEZONE=America/Campo_Grande
STORE_CLOCK=2026-03-24T10:00:00

# ---- portas expostas pelo compose ----
API_PORT=8000
WEB_PORT=3000
