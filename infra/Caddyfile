# Roadie em produção: um domínio, HTTPS automático.
# "/api/*" vai para a API (prefixo removido); o resto é o console Next.js.
{$ROADIE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			# Server-Sent Events: não bufferizar a resposta
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
